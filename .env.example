# ===========================================
# mikroKSeF Configuration
# ===========================================
# Copy this file to .env and fill in values

# ----- KSeF Environment -----
# Options: test, demo, production
KSEF_ENVIRONMENT=test

# KSeF API URLs (auto-selected based on environment, but can override)
# Test: https://ksef-test.mf.gov.pl/api
# Demo: https://ksef-demo.mf.gov.pl/api
# Production: https://ksef.mf.gov.pl/api
# KSEF_API_URL=https://ksef-test.mf.gov.pl/api

# ----- Company Credentials -----
# Your company NIP (10 digits, no dashes)
COMPANY_NIP=1234567890

# KSeF Authorization Token
# Generate this from KSeF portal after signing in with qualified signature
KSEF_AUTH_TOKEN=your_authorization_token_here

# ----- Certificate Authentication (Alternative) -----
# Path to qualified certificate (PEM format)
# CERTIFICATE_PATH=/path/to/certificate.pem
# PRIVATE_KEY_PATH=/path/to/private-key.pem
# PRIVATE_KEY_PASSWORD=your_key_password

# ----- Application Settings -----
# Application name
APP_NAME=mikroKSeF

# Debug mode (set to false in production)
DEBUG=true

# Backend URL (for CORS)
BACKEND_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Session Settings -----
# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60

# ----- Database -----
# SQLite database path
DATABASE_URL=sqlite:///./mikroksef.db

# ----- Security -----
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# JWT token expiration in minutes
JWT_EXPIRATION_MINUTES=60

# ----- Logging -----
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
